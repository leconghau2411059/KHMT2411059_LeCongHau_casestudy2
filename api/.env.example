# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.
PORT=3000
MONGODB_URI=mongodb://localhost:27017/task_manager

# Chuỗi bí mật ký JWT. Tạo ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Email (SMTP). Để trống SMTP_HOST thì email chỉ được ghi log ra console (không gửi thật).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<email>, SMTP_PASS=<mật khẩu ứng dụng>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Task Manager <no-reply@example.com>
# Số lần gửi tối đa cho mỗi email (gồm lần đầu và gửi lại thủ công)
EMAIL_MAX_ATTEMPTS=3

# Nhắc việc sắp đến hạn
REMINDER_ENABLED=true
REMINDER_INTERVAL_MINUTES=15
REMINDER_HOURS_BEFORE=24
